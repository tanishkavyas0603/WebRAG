# ============================================================
# WebRAG — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- AI Provider Keys (REQUIRED) ---
# Groq API key — obtain from https://console.groq.com/
GROQ_API_KEY=

# Hugging Face token — obtain from https://huggingface.co/settings/tokens
# Required for sentence-transformers/all-MiniLM-L6-v2 embeddings
HF_TOKEN=

# --- Database ---
# SQLite for local development:
DATABASE_URL=sqlite:///./webrag.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:pass@host:5432/webrag

# --- Security ---
# CRITICAL: Generate a strong random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_in_production_secret_key

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Groq LLM Model ---
GROQ_MODEL=qwen/qwen3.6-27b

# --- RAG Parameters ---
TOP_K=5
RETRIEVAL_MULTIPLIER=3

# --- Storage ---
DATA_PATH=data
FAISS_INDEX_DIR=./data/index

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate Limiting ---
# Note: process-local only — not distributed across multiple workers/instances
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
